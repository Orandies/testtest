# =============================================================================
# GigaChat (LLM) - Обязательно (один из режимов)
# =============================================================================

# --- Режим токена (наиболее распространенный) ---
# Учетные данные (credentials) из личного кабинета разработчика Сбер
GIGACHAT_CREDENTIALS=your_credentials_here

# Адрес сервиса аутентификации вашего контура (обязательно для режима токена)
# Примеры:
#   Prod:    https://ngw.devices.sberbank.ru:9443/api/v2/oauth
#   Pre-prod: https://preprod-ngw.devices.sberbank.ru:9443/api/v2/oauth
#   Test:    https://test-ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# Scope (права доступа) - должно точно совпадать с выданными в портале
# Обычно это "B2B" или "GIGACHAT_API_PERS" (без кавычек, запятых и лишнего)
GIGACHAT_SCOPE=B2B

# Модель GigaChat (по умолчанию GigaChat-2)
GIGACHAT_MODEL=GigaChat-2

# Базовый URL API GigaChat (опционально, по умолчанию prod)
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1/

# Проверка SSL сертификата GigaChat (по умолчанию false)
GIGACHAT_VERIFY_SSL=false

# Температура генерации (0.0-1.0): чем выше, тем креативнее ответы (по умолчанию 0.7)
# Для более естественных и менее роботизированных ответов рекомендуется 0.7-0.9
GIGACHAT_TEMPERATURE=0.7

# Top P (0.0-1.0): альтернатива температуре, ограничивает разнообразие токенов (по умолчанию 0.9)
GIGACHAT_TOP_P=0.9


# =============================================================================
# SourceControl / Bitbucket - Для orchestrator-режима и git clone
# =============================================================================
# В текущей версии агента используется единая настройка для системы контроля версий.
# Если вы используете Bitbucket Сбербанка как основную систему контроля версий,
# укажите его URL и токен здесь.

# Базовый URL вашего Bitbucket / Source Control (например, https://bitbucket.sberbank.ru)
SOURCECONTROL_BASE_URL=https://bitbucket.sberbank.ru

# HTTP Access Token из настроек Bitbucket (вместо пароля)
# Создайте токен в настройках профиля Bitbucket (App Password / HTTP access token)
# с правами на чтение/запись репозиториев.
SOURCECONTROL_TOKEN=your_bitbucket_http_access_token


# =============================================================================
# Confluence - Для orchestrator-режима (чтение планов установки)
# =============================================================================

# Базовый URL вашего Confluence
CONFLUENCE_BASE_URL=https://confluence.sberbank.ru

# Токен доступа к Confluence
CONFLUENCE_TOKEN=your_confluence_token

# Проверка SSL сертификата Confluence (по умолчанию true)
CONFLUENCE_VERIFY_SSL=true

# Путь к корневому CA-сертификату (для самоподписанных сертификатов)
# CONFLUENCE_CA_BUNDLE=/path/to/ca-bundle.crt


# =============================================================================
# Агент - Обязательные настройки
# =============================================================================

# Список разрешенных пользователей (через запятую, без пробелов после запятой)
# Это должны быть ваши user_id в системе (например, email или SID)
AGENT_ALLOWED_USERS=your_user_id@sigma.sbrf.ru

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# Рабочая директория для Git операций (где будут создаваться репозитории)
# Укажите абсолютный путь к вашей папке sandbox
GIT_WORK_DIR=/home/work/22947211@sigma.sbrf.ru/testtest/sandbox


# =============================================================================
# SberChat Bot (опционально, для уведомлений)
# =============================================================================

# Токен бота SberChat (получить через @SberChatBot)
# SBERCHAT_BOT_TOKEN=your_bot_token

# Webhook токен для уведомлений
# SBERCHAT_WEBHOOK_TOKEN=your_webhook_token

# Путь к PEM-файлу корневого CA-сертификата для SberChat
# SBERCHAT_ROOT_CERTS=/path/to/root-certs.pem

# Использовать sandbox окружение SberChat (true/false)
# SBERCHAT_SANDBOX=false
