# =============================================================================
# GigaChat (LLM) - Обязательно (один из режимов)
# =============================================================================

# --- Режим токена (наиболее распространенный) ---
GIGACHAT_CREDENTIALS=your_credentials_here
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_SCOPE=B2B
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1/
GIGACHAT_VERIFY_SSL=false
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_TOP_P=0.9


# =============================================================================
# SourceControl / Bitbucket - Для orchestrator-режима и git clone
# =============================================================================

# Базовый URL вашего Bitbucket / Source Control
SOURCECONTROL_BASE_URL=https://bitbucket.sberbank.ru

# HTTP Access Token из настроек Bitbucket (вместо пароля)
SOURCECONTROL_TOKEN=your_bitbucket_http_access_token


# =============================================================================
# Confluence - Для orchestrator-режима (чтение планов установки)
# =============================================================================

CONFLUENCE_BASE_URL=https://confluence.sberbank.ru
CONFLUENCE_TOKEN=your_confluence_token
CONFLUENCE_VERIFY_SSL=true


# =============================================================================
# Агент - Обязательные настройки
# =============================================================================

AGENT_ALLOWED_USERS=your_user_id@sigma.sbrf.ru
AGENT_LOG_LEVEL=INFO
GIT_WORK_DIR=/tmp/sandbox


# =============================================================================
# Bitbucket Git Authentication - для прямых Git команд
# =============================================================================
# Эти настройки позволяют агенту выполнять git clone/push/pull через HTTPS
# с использованием логина и пароля (или токена вместо пароля)
#
# ВАЖНО: Для Bitbucket Сбербанка рекомендуется использовать HTTP Access Token
# вместо пароля. Создать токен можно в настройках профиля Bitbucket:
#   1. Откройте https://bitbucket.sberbank.ru
#   2. Перейдите в настройки профиля (Manage account)
#   3. Выберите "App passwords" или "HTTP access tokens"
#   4. Создайте новый токен с правами на чтение/запись репозиториев
#   5. Скопируйте токен и используйте его как BITBUCKET_PASSWORD

BITBUCKET_USERNAME=admin
BITBUCKET_PASSWORD=123321

# URL вашего Bitbucket репозитория (пример, можно указать при клонировании)
# BITBUCKET_REPO_URL=https://bitbucket.sberbank.ru/scm/PROJECT/repo.git
